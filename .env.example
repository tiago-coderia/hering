# ==========================================
# Variáveis de Ambiente do Sistema Checklist PWA
# Copie este arquivo para .env na raiz ou configure por serviço
# ==========================================

# Ambiente de Execução
NODE_ENV=development

# API Backend (Express)
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Banco de Dados PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=checklist_db
POSTGRES_PORT=5432

# URL de Conexão com o Banco (Host local vs Docker)
# Para execução local direta no host:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/checklist_db?schema=public"
# Para execução no Docker Compose (rede interna):
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/checklist_db?schema=public"

# Autenticação JWT
JWT_SECRET=super-secret-jwt-key-checklist-pwa-2026-min-32-chars
JWT_EXPIRES_IN=7d

# Armazenamento Local de Fotos (LocalDiskStorage)
# No host:
UPLOAD_DIR=./data/uploads
# No container Docker:
# UPLOAD_DIR=/app/storage/uploads

# Limites de Upload
MAX_FILE_SIZE_MB=10

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
PORT_WEB=3000

